---
import Layout from '../layouts/Layout.astro';
import PaymentMethod from '../components/PaymentMethod.astro';

const Name = "Stellarwaves-5";

// The publishable key is read from .env at build/request time and written into
// a <meta> tag so the client-side script in PaymentMethod.astro can pick it up
// without embedding secrets in source code.
const stripePk = import.meta.env.STRIPE_PUBLISHABLE_KEY ?? import.meta.env.STRIPE_PUBLISHABLE_KEY ?? '';
---

<Layout title={Name}>
    <!-- Stripe publishable key — readable by PaymentMethod.astro client script -->
    <meta name="stripe-pk" content={stripePk} />

    <main>
        <PaymentMethod />
    </main>
</Layout>

<style>
    body {
        display: grid;
        place-items: center;
        position: relative;
        min-height: 100vh;
    }

    body::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: center / 100% 100% no-repeat
            url(../assets/images/background/new/GSFC_20171208_Archive_e001434_orig.webp);
        opacity: 0.45;
        z-index: -1;
    }

    main {
        height: auto;
        margin: 15rem 0 45vh 0;
    }
</style>