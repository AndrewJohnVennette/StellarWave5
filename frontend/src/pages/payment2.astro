---
import Layout from '../layouts/Layout.astro';
import PaymetMethod from '../components/PaymentMethod.astro'

const Name = "Stellarwaves-5";
---
<Layout title={Name}>
    <main>
        <PaymetMethod>

        </PaymetMethod>   
    </main>
</Layout>
<style>
    body {
    display: grid;
    place-items: center;
    position: relative;           /* Important */
    min-height: 100vh;            /* Ensures full height */
    }

/* Background image with opacity */
    body::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: center / cover no-repeat url(../assets/images/background/new/GSFC_20171208_Archive_e001434_orig.webp);
        opacity: 0.45;                 /* Change this value as needed */
        z-index: -1;                  /* Places it behind content */
    }
    main{
        height: auto;
        margin: 15rem 0 45vh 0;
    }
</style>