    const lastNameInput  = document.getElementById('last-name');
    const emailInput     = document.getElementById('email');
 
    let saveTimer        = null;   // debounce handle
    let lastSavedKey     = '';     // avoid sending the same data twice
 
    /** Returns true only when all three fields have non-empty, trimmed values
     *  and the email field passes basic format validation. */
    function allFieldsComplete() {
        const fn = firstNameInput.value.trim();
        const ln = lastNameInput.value.trim();
        const em = emailInput.value.trim();
        const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(em);
        return fn !== '' && ln !== '' && emailOk;
    }
 
    /** POSTs to the Express /api/register endpoint. */
    async function saveUser() {
        const firstName = firstNameInput.value.trim();
        const lastName  = lastNameInput.value.trim();
        const email     = emailInput.value.trim();
 
        // De-duplicate: skip if we already saved this exact combination
        const key = `${firstName}|${lastName}|${email}`;
        if (key === lastSavedKey) return;
 
        try {
            const res = await fetch('http://localhost:3000/api/register', {
                method:  'POST',
                headers: { 'Content-Type': 'application/json' },
                body:    JSON.stringify({ firstName, lastName, email }),
            });
 
            const data = await res.json();
 
            if (res.ok) {
                lastSavedKey = key;   // mark as saved so we don't repeat it
                console.log('[AutoSave] User saved:', data.message);
            } else if (res.status === 409) {
                // Email already in DB — treat as a silent success so UX isn't disrupted
                lastSavedKey = key;
                console.log('[AutoSave] Email already registered — skipping duplicate.');
            } else {
                console.warn('[AutoSave] Server error:', data.error);
            }
        } catch (err) {
            console.error('[AutoSave] Network error:', err);
        }
    }
 
    /** Debounced handler attached to every input event on the three fields.
     *  Waits 600 ms of inactivity before attempting the save. */
    function handleUserInput() {
        clearTimeout(saveTimer);
        if (!allFieldsComplete()) return;
        saveTimer = setTimeout(saveUser, 600);
    }
 
    firstNameInput.addEventListener('input', handleUserInput);
    lastNameInput .addEventListener('input', handleUserInput);
    emailInput    .addEventListener('input', handleUserInput);
 
    //
    // ─────────────────────────────────────────────────────────────────────────────
 








    const select = document.getElementById('destinationSelect');
    const fields = {
        name:     document.getElementById('infoName'),
        distance: document.getElementById('infoDistance'),
        location: document.getElementById('infoLocation'),
        arrival:  document.getElementById('infoArrival')
    };
    const destImage   = document.getElementById('destImage');
    const imgPlaceholder = document.getElementById('imgPlaceholder');
    const comments    = document.getElementById('destComments');

    function pulse(el) {
        el.classList.remove('pulse');
        void el.offsetWidth; // reflow
        el.classList.add('pulse');
    }

    select.addEventListener('change', () => {
        const key = select.value;
        if (!key) {
        Object.values(fields).forEach(f => { f.textContent = '—'; f.classList.remove('populated'); });
        destImage.src = '';
        destImage.classList.remove('visible');
        imgPlaceholder.style.display = 'flex';
        comments.value = '';
        comments.placeholder = 'Select a destination to load mission notes…';
        comments.removeAttribute('style');
        checkProceedButton();
        return;
        }
        const d = destinations[key];

        // Fill info
        const map = { name: d.name, distance: d.distance, location: d.location, arrival: d.arrival };
        Object.entries(map).forEach(([k, v]) => {
        fields[k].textContent = v;
        fields[k].classList.add('populated');
        pulse(fields[k]);
        });

        // Image
        imgPlaceholder.style.display = 'none';
        destImage.classList.remove('visible');
        destImage.src = d.image;
        destImage.onload = () => destImage.classList.add('visible');
        destImage.onerror = () => { imgPlaceholder.style.display = 'flex'; };

        // Comments
        comments.removeAttribute('readonly');
        comments.value = d.comments;
        comments.style.color = 'var(--text)';

        checkProceedButton();
    });

    // ── Proceed-to-Payment button gating ──────────────────────────────────────
    const proceedBtn = document.getElementById('proceed-to-payment');
    const checkboxes = document.querySelectorAll('#card-payload section.center input[type="checkbox"]');

    function checkProceedButton() {
        const fn      = firstNameInput.value.trim();
        const ln      = lastNameInput.value.trim();
        const em      = emailInput.value.trim();
        const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(em);
        const destOk  = select.value !== '';
        const anyCheck = [...checkboxes].some(cb => cb.checked);
        proceedBtn.disabled = !(fn && ln && emailOk && destOk && anyCheck);
    }

    // Re-run gating whenever fields change
    [firstNameInput, lastNameInput, emailInput].forEach(el =>
        el.addEventListener('input', checkProceedButton)
    );
    checkboxes.forEach(cb => cb.addEventListener('change', checkProceedButton));

    // Navigate to payment, carrying selection in sessionStorage
    proceedBtn.addEventListener('click', () => {
        const selected = [...checkboxes]
            .filter(cb => cb.checked)
            .map(cb => ({
                id:    cb.id,
                name:  cb.dataset.name,
                price: parseFloat(cb.dataset.price)
            }));

        const payload = {
            firstName:   firstNameInput.value.trim(),
            lastName:    lastNameInput.value.trim(),
            email:       emailInput.value.trim(),
            destination: select.options[select.selectedIndex].text,
            items:       selected
        };

        sessionStorage.setItem('stellarPayload', JSON.stringify(payload));
        window.location.href = '/payment';
    });

    // Evaluate once on load (browser auto-fill)
    checkProceedButton();
</script>
