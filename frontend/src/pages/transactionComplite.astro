---
import Layout from '../layouts/Layout.astro';
const Name = "Stellarwaves-5 — Mission Confirmed";
---

<Layout title={Name}>
    <main class="success-page">

        <div class="success-card">

            <!-- Animated checkmark -->
            <div class="checkmark-wrap" aria-hidden="true">
                <svg class="checkmark" viewBox="0 0 52 52" xmlns="http://www.w3.org/2000/svg">
                    <circle class="checkmark__circle" cx="26" cy="26" r="25" fill="none"/>
                    <path   class="checkmark__check"  fill="none" d="M14 27l8 8 16-16"/>
                </svg>
            </div>

            <h1 class="success-title">Mission Confirmed</h1>
            <p class="success-subtitle">Your transaction was completed successfully.</p>

            <div class="success-divider"></div>

            <p class="success-body">
                Your message is now queued for transmission. A confirmation
                receipt has been sent to the email address provided.
            </p>

            <a href="/" class="back-btn">Return to Home</a>

        </div>

    </main>
</Layout>

<style>
    body {
        position: relative;
        min-height: 100vh;
        display: grid;
        place-items: center;
    }

    body::before {
        content: '';
        position: absolute;
        inset: 0;
        background: center / cover no-repeat
            url(../assets/images/background/new/GSFC_20171208_Archive_e001434_orig.webp);
        opacity: 0.35;
        z-index: -1;
    }

    /* ── Success card ── */
    .success-page {
        display: grid;
        place-items: center;
        min-height: 100vh;
        padding: 2rem;
    }

    .success-card {
        position: relative;
        background: var(--surface);
        border: var(--border-w) solid var(--border);
        border-radius: var(--radius);
        padding: 3.5rem 3rem 2.8rem;
        max-width: 480px;
        width: 90vw;
        text-align: center;
        box-shadow:
            0 0 0 1px rgba(255,255,255,.05) inset,
            0 24px 60px rgba(0,0,0,.65);
        animation: scardIn .55s cubic-bezier(.22,1,.36,1) both;
    }

    /* ── Animated SVG checkmark ── */
    .checkmark-wrap {
        width: 72px;
        height: 72px;
        margin: 0 auto 1.6rem;
    }

    .checkmark {
        width: 100%;
        height: 100%;
    }

    .checkmark__circle {
        stroke: #00dfc4;
        stroke-width: 2.5;
        stroke-dasharray: 166;
        stroke-dashoffset: 166;
        stroke-linecap: round;
        animation: strokeIn .6s cubic-bezier(.65,0,.45,1) .1s forwards;
    }

    .checkmark__check {
        stroke: #00dfc4;
        stroke-width: 3;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-dasharray: 48;
        stroke-dashoffset: 48;
        animation: strokeIn .35s cubic-bezier(.65,0,.45,1) .65s forwards;
    }

    /* ── Text ── */
    .success-title {
        font-size: clamp(1.4rem, 4vw, 2rem);
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: #fff;
        margin: 0 0 .5rem;
    }

    .success-subtitle {
        font-size: .95rem;
        color: #00dfc4;
        letter-spacing: .08em;
        margin: 0;
    }

    .success-divider {
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--border) 30%, var(--border) 70%, transparent);
        margin: 1.6rem 0;
    }

    .success-body {
        font-size: .9rem;
        color: rgba(255,255,255,.65);
        line-height: 1.7;
        margin: 0 0 2rem;
    }

    /* ── Back button ── */
    .back-btn {
        display: inline-block;
        padding: .7rem 2.4rem;
        background: linear-gradient(135deg, #1e4fad, #3d8ef0);
        color: #fff;
        font-family: var(--basicFontFamily);
        font-size: .85rem;
        font-weight: 600;
        letter-spacing: .1em;
        text-transform: uppercase;
        text-decoration: none;
        border-radius: 30px;
        box-shadow: 0 4px 18px rgba(61,142,240,.35);
        transition: transform .15s ease, box-shadow .15s ease;

        &:hover  { transform: translateY(-2px); box-shadow: 0 6px 24px rgba(61,142,240,.5); }
        &:active { transform: translateY(0); }
    }

    /* ── Animations ── */
    @keyframes scardIn {
        from { opacity: 0; transform: translateY(20px) scale(.97); }
        to   { opacity: 1; transform: translateY(0)    scale(1);   }
    }

    @keyframes strokeIn {
        to { stroke-dashoffset: 0; }
    }
</style>