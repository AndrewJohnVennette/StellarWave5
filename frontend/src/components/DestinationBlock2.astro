// ─────────────────────────────────────────────────────────────────────────────
// LIGHT-TRAVEL TIME COMPUTATION (for reference / UI use)
// Given a distance in light-years, this helper returns the exact breakdown.
// ─────────────────────────────────────────────────────────────────────────────

/**
 * Converts a distance in light-years to a human-readable travel time
 * for a photon (moving at c).
 *
 * @param {number} ly - Distance in light-years
 * @returns {string} Formatted string: "X años, Y meses, Z días, H horas, M minutos, S segundos"
 */
function arrival(ly) {
    const SECONDS_PER_YEAR  = 365.25 * 24 * 3600;      // Julian year
    const SECONDS_PER_MONTH = SECONDS_PER_YEAR / 12;
    const SECONDS_PER_DAY   = 24 * 3600;
    const SECONDS_PER_HOUR  = 3600;
    const SECONDS_PER_MIN   = 60;

    let remaining = ly * SECONDS_PER_YEAR;

    const years   = Math.floor(remaining / SECONDS_PER_YEAR);   remaining %= SECONDS_PER_YEAR;
    const months  = Math.floor(remaining / SECONDS_PER_MONTH);  remaining %= SECONDS_PER_MONTH;
    const days    = Math.floor(remaining / SECONDS_PER_DAY);    remaining %= SECONDS_PER_DAY;
    const hours   = Math.floor(remaining / SECONDS_PER_HOUR);   remaining %= SECONDS_PER_HOUR;
    const minutes = Math.floor(remaining / SECONDS_PER_MIN);    remaining %= SECONDS_PER_MIN;
    const seconds = Math.floor(remaining);

    return `${years} años, ${months} meses, ${days} días, ${hours} horas, ${minutes} minutos, ${seconds} segundos`;
}

// Example:
// console.log(arrival(4.24));
// → "4 años, 2 meses, 28 días, 19 horas, 33 minutos, 36 segundos"


    const select = document.getElementById('destinationSelect');
    const fields = {
        name:     document.getElementById('infoName'),
        distance: document.getElementById('infoDistance'),
        location: document.getElementById('infoLocation'),
        arrival:  document.getElementById('infoArrival')
    };
    const destImage   = document.getElementById('destImage');
    const imgPlaceholder = document.getElementById('imgPlaceholder');
    const comments    = document.getElementById('destComments');

    function pulse(el) {
        el.classList.remove('pulse');
        void el.offsetWidth; // reflow
        el.classList.add('pulse');
    }

    select.addEventListener('change', () => {
        const key = select.value;
        if (!key) {
        Object.values(fields).forEach(f => { f.textContent = '—'; f.classList.remove('populated'); });
        destImage.src = '';
        destImage.classList.remove('visible');
        imgPlaceholder.style.display = 'flex';
        comments.value = '';
        comments.placeholder = 'Select a destination to load mission notes…';
        comments.removeAttribute('style');
        return;
        }
        const d = destinations[key];

        // Fill info
        const map = { name: d.name, distance: d.distance, location: d.location, arrival: d.arrival };
        Object.entries(map).forEach(([k, v]) => {
        fields[k].textContent = v;
        fields[k].classList.add('populated');
        pulse(fields[k]);
        });

        // Image
        imgPlaceholder.style.display = 'none';
        destImage.classList.remove('visible');
        destImage.src = d.image;
        destImage.onload = () => destImage.classList.add('visible');
        destImage.onerror = () => { imgPlaceholder.style.display = 'flex'; };

        // Comments
        comments.removeAttribute('readonly');
        comments.value = d.comments;
        comments.style.color = 'var(--text)';
    });
</script>