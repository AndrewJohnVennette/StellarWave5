    .select-arrow {
        position: absolute; 
        right: 1rem; 
        top: 50%; 
        transform: translateY(-50%);
        pointer-events: none; 
        color: var(--accent);
        & svg { 
            display: block; 
        }
    }
    /* ── INFO GRID ── */
