---
---

<h1>Payment Form</h1>
<p class="test-hint">Test card: <code>4242 4242 4242 4242</code> · CVC: <code>123</code> · Exp: <code>10/40</code> · ZIP: <code>33139</code></p>

<h3>Selected Services Summary</h3>
<table id="summary-table">
  <thead>
    <tr>
      <th>Service</th>
      <th>Price</th>
    </tr>
  </thead>
  <tbody id="summary-body"></tbody>
  <tfoot>
    <tr>
      <td class="total">Total</td>
      <td id="total-amount" class="total">$0.00</td>
    </tr>
  </tfoot>
</table>

<!-- Error dialog (shown on payment failure) -->
<dialog id="error-dialog">
  <div class="dialog-inner">
    <p class="dialog-msg">⚠️ Something went wrong, check and try again.</p>
    <p id="dialog-detail" class="dialog-detail"></p>
    <button id="dialog-close" class="dialog-close-btn">Close</button>
  </div>
</dialog>

<form id="payment-form" action="">
  <section class="container">
    <div class="card front-face">
      <header>
        <span class="logo">
          <h5>Stellar Card</h5>
        </span>
      </header>

      <div class="card-details">
        <div class="name-number">
          <h6>Card Number</h6>
          <div id="cardNumber" class="number"></div>
          <h6>Card Holder Name</h6>
          <input id="cardName" class="name" type="text" placeholder="Enter your name" required />
        </div>
        <div class="valid-date">
          <h6>Valid Thru</h6>
          <div id="expDate"></div>
        </div>
      </div>
    </div>

    <div class="card back-face">
      <h6>For support: stellarwaves@cosmos.io</h6>
      <span class="magnetic-strip"></span>
      <div class="signature"><div id="CVC"></div></div>
    </div>
  </section>

  <div id="card-errors" role="alert"></div>
  <!-- <button type="submit" id="submit-btn">Submit Payment</button> -->
  <button type="submit">Submit Payment</button>
</form>

<style>
:root { --minColumnSize: 12rem }

.test-hint {
  text-align: center;
  color: #a0b0c8;
  font-size: .85rem;
  margin-bottom: 1rem;
}
.test-hint code {
  background: #1a2236;
  padding: 2px 6px;
  border-radius: 4px;
  color: #00dfc4;
}

#summary-table {
  width: 80%;
  margin: 20px auto;
  border-collapse: collapse;
  color: #fff;
}
#summary-table th, #summary-table td {
  border: 1px solid #ccc;
  padding: 10px;
  text-align: left;
}
#summary-table th { background-color: #6366f1; }
#summary-table .total { font-weight: bold; }

/* ── Error dialog ─────────────────────────────────── */
#error-dialog {
  border: 2px solid #f05a3d;
  border-radius: 12px;
  background: #161b27;
  color: #e8e4dc;
  padding: 0;
  max-width: 400px;
  width: 90vw;
}
#error-dialog::backdrop {
  background: rgba(0,0,0,.65);
}
.dialog-inner {
  padding: 2rem 2.2rem;
  text-align: center;
}
.dialog-msg {
  font-size: 1.1rem;
  margin-bottom: .5rem;
  color: #f9a825;
}
.dialog-detail {
  font-size: .85rem;
  color: #a0b0c8;
  margin-bottom: 1.5rem;
  min-height: 1.2rem;
}
.dialog-close-btn {
  background: #f05a3d;
  color: #fff;
  border: none;
  border-radius: 8px;
  padding: .6rem 1.8rem;
  font-size: .95rem;
  cursor: pointer;
}
.dialog-close-btn:hover { background: #d9472d; }

/* ── Card UI ──────────────────────────────────────── */
.container {
  perspective: 1000px;
  width: 350px;
  height: 220px;
  margin: 20px auto;
}
.card {
  position: absolute;
  width: 100%;
  height: 100%;
  transition: transform 0.6s;
  transform-style: preserve-3d;
  backface-visibility: hidden;
}
.front-face {
  background: linear-gradient(135deg, #6366f1, #a855f7);
  border-radius: 10px;
  padding: 20px;
  transform: rotateY(0deg);
}
.back-face {
  background: linear-gradient(135deg, #6366f1, #a855f7);
  border-radius: 10px;
  padding: 20px;
  transform: rotateY(180deg);
}
.container.flipped .front-face { transform: rotateY(-180deg); }
.container.flipped .back-face  { transform: rotateY(0deg); }

.front-face header,
.front-face .logo { display: flex; align-items: center; }
.front-face header { justify-content: space-between; }
h5 { font-size: 16px; font-weight: 400; }
.front-face .card-details {
  display: flex;
  margin-top: 40px;
  align-items: flex-end;
  justify-content: space-between;
}
h6 { font-size: 10px; font-weight: 400; }
.number { font-size: 27px; letter-spacing: 1px; }
.name   { margin-top: 20px; }

.card.back-face { border: none; padding: 15px 25px 25px; }
.card.back-face h6 { font-size: 8px; }
.card.back-face .magnetic-strip {
  position: absolute; top: 40px; left: 0;
  height: 45px; width: 100%; background: #000;
}
.card.back-face .signature {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-top: 80px;
  height: 40px;
  width: 85%;
  border-radius: 6px;
  background: repeating-linear-gradient(#fff, #fff 3px, #efefef 0, #efefef 9px);
}
.card.back-face .signature div {
  color: #000; font-size: 12px; padding: 4px 6px;
  border-radius: 4px; margin-right: -30px; z-index: -1; width: 35px;
}

input {
  background: transparent; border: none; color: #fff;
  font-family: 'Poppins', sans-serif; font-size: 16px; width: 100%; padding: 0;
}
input:focus { outline: none; border: 1px solid red; }
#expDate { width: 62px; }

#card-errors {
  color: #fa755a; margin: 10px 0;
  font-size: 14px; text-align: center;
}

button[type="submit"] {
  width: 60%; padding: 10px;
  background: #6366f1; color: white;
  border: none; border-radius: 5px;
  font-size: 16px; cursor: pointer;
  display: block; margin: 1rem auto 0;
}
button[type="submit"]:hover { background: #a855f7; }
button[type="submit"]:disabled {
  background: #444; color: #888; cursor: not-allowed;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  // ── Load selection from sessionStorage ──────────────────────
  const payload = JSON.parse(sessionStorage.getItem('stellarPayload') || 'null');
  const summaryBody        = document.getElementById('summary-body');
  const totalAmountEl      = document.getElementById('total-amount');
  const submitBtn          = document.getElementById('submit-btn');

  let totalCents = 0;

  if (!payload || !payload.items || payload.items.length === 0) {
    summaryBody.innerHTML = '<tr><td colspan="2">No services selected. Please go back.</td></tr>';
    submitBtn.disabled = true;
  } else {
    let totalDollars = 0;
    payload.items.forEach(item => {
      const row = document.createElement('tr');
      row.innerHTML = `<td>${item.name}</td><td>$${item.price.toFixed(2)}</td>`;
      summaryBody.appendChild(row);
      totalDollars += item.price;
    });
    totalAmountEl.textContent = `$${totalDollars.toFixed(2)}`;
    totalCents = Math.round(totalDollars * 100);   // convert to cents for Stripe
  }

  // ── Error dialog helpers ────────────────────────────────────
  const errorDialog  = document.getElementById('error-dialog');
  const dialogDetail = document.getElementById('dialog-detail');

  document.getElementById('dialog-close').addEventListener('click', () => {
    errorDialog.close();
  });

  function showError(msg) {
    dialogDetail.textContent = msg || '';
    errorDialog.showModal();
  }

  // ── Stripe setup ────────────────────────────────────────────
  var stripe   = Stripe('pk_test_51QkE43C1UqQhFhw44FBwsaPxexyTd3KbAAdIkEf1eWCsBtdKk4FTQ04JQil8zGQ3BMkFTsIW34zpO4ICVGeXOdgm001REg2tXE');
  var elements = stripe.elements();

  var style = {
    base: {
      fontSize: '16px',
      color: '#fff',
      fontFamily: '"Poppins", sans-serif',
      '::placeholder': { color: 'rgba(255,255,255,.7)' }
    },
    invalid: { color: '#fa755a' }
  };

  var cardNumber = elements.create('cardNumber', { style });
  cardNumber.mount('#cardNumber');

  var cardExpiry = elements.create('cardExpiry', { style });
  cardExpiry.mount('#expDate');

  var cardCvc = elements.create('cardCvc', { style });
  cardCvc.mount('#CVC');

  let cardNumberFilled = false;
  let expDateFilled    = false;
  let cvcFilled        = false;

  function updateFlip() {
    const cardName = document.getElementById('cardName').value.trim();
    const container = document.querySelector('.container');
    const frontOk = cardNumberFilled && cardName && expDateFilled;
    if (frontOk && !cvcFilled && !container.classList.contains('flipped')) {
      container.classList.add('flipped');
    } else if (frontOk && cvcFilled && container.classList.contains('flipped')) {
      container.classList.remove('flipped');
    } else if (!frontOk && container.classList.contains('flipped')) {
      container.classList.remove('flipped');
    }
  }

  cardNumber.on('change', e => { cardNumberFilled = e.complete; document.getElementById('card-errors').textContent = e.error ? e.error.message : ''; updateFlip(); });
  cardExpiry.on('change', e => { expDateFilled    = e.complete; document.getElementById('card-errors').textContent = e.error ? e.error.message : ''; updateFlip(); });
  cardCvc.on   ('change', e => { cvcFilled        = e.complete; document.getElementById('card-errors').textContent = e.error ? e.error.message : ''; updateFlip(); });
  document.getElementById('cardName').addEventListener('input', updateFlip);

  // ── Form submit ──────────────────────────────────────────────
  document.getElementById('payment-form').addEventListener('submit', async function (e) {
    e.preventDefault();

    if (!payload || !payload.items || payload.items.length === 0) {
      showError('Shopping cart is empty. Please go back and select services.');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Processing…';

    const cardName  = document.getElementById('cardName').value.trim();
    const firstNameMatch = cardName.match(/^[^ ]+/);
    const lastNameMatch  = cardName.match(/[^ ]+$/);
    const firstName = firstNameMatch ? firstNameMatch[0] : (payload.firstName || 'Unknown');
    const lastName  = lastNameMatch  ? lastNameMatch[0]  : (payload.lastName  || 'Unknown');

    try {
      // 1. Create a PaymentMethod
      const { paymentMethod, error: pmError } = await stripe.createPaymentMethod({
        type: 'card',
        card: cardNumber,
        billing_details: { name: cardName }
      });

      if (pmError) {
        document.getElementById('card-errors').textContent = pmError.message;
        showError(pmError.message);
        submitBtn.disabled = false;
        submitBtn.textContent = 'Submit Payment';
        return;
      }

      // 2. Send to server
      const response = await fetch('http://localhost:3000/create-payment-intent', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          paymentMethodId: paymentMethod.id,
          totalAmount:     totalCents,
          firstName,
          lastName
        })
      });

      const data = await response.json();

      if (!response.ok || data.error) {
        const msg = data.error || `Server error ${response.status}`;
        document.getElementById('card-errors').textContent = msg;
        showError(msg);
        submitBtn.disabled = false;
        submitBtn.textContent = 'Submit Payment';
        return;
      }

      // 3. Handle 3D Secure if needed
      if (data.requiresAction) {
        const { error: confirmError } = await stripe.handleCardAction(data.clientSecret);
        if (confirmError) {
          showError(confirmError.message);
          submitBtn.disabled = false;
          submitBtn.textContent = 'Submit Payment';
          return;
        }
        // Re-confirm after 3DS
        const confirmResp = await fetch('http://localhost:3000/create-payment-intent', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            paymentMethodId: paymentMethod.id,
            totalAmount:     totalCents,
            firstName,
            lastName
          })
        });
        const confirmData = await confirmResp.json();
        if (!confirmResp.ok || confirmData.error) {
          showError(confirmData.error || 'Payment failed after 3D Secure.');
          submitBtn.disabled = false;
          submitBtn.textContent = 'Submit Payment';
          return;
        }
      }

      // 4. Success — clear sessionStorage and redirect
      sessionStorage.removeItem('stellarPayload');
      window.location.href = 'http://localhost:3000/success';

    } catch (err) {
      console.error('[Payment]', err);
      showError(err.message || 'Unexpected error. Please try again.');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Submit Payment';
    }
  });
});
</script>
