---
import stellarLogo from '../assets/Stellarwave.png';
const { services = "/services2"} = Astro.props;
---
<header id="GEV-navBar" class="flex">
            <!-- Company Logo -->
            <div>
                <img src={stellarLogo.src} alt="Logo of Corp" class="logo">
            </div>
            <!-- Dynamic Hamburger -->
            <button class="mobile-nav-toggle " aria-controls="primary-navigation" aria-expanded="false">
                <div class="menu-btn">
                    <div class="menu-btn_burger"></div>
                </div>
            </button>
            <!-- Menu Section -->
            <nav>
                <ul data-visible="false" class="primary-navigation flex">
                    <li class="active">
                        <a class="ff-sans-cond uppercase text-white letter-spacing" href="/">
                            <span aria-hidden="true">Home</span>
                        </a>
                    </li>
                    <li>
                        <a href={services}>
                            <span aria-hidden="true">Services</span>
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            <span aria-hidden="true">Info</span>
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            <span aria-hidden="true">Language</span>
                        </a>
                    </li>
                </ul>
            </nav>
            <!-- End Menu Section -->
        </header>

<style>
    /********************** NavBar Section **********************/
:root {
    --gap: 2rem;
    --textColor: #fff;
    --textSize: 1rem;
    --borderBottomLeftRadius: 55%;
}

#GEV-navBar {
    position: fixed;      /* sticks to viewport, doesn't scroll away */
    top: 0;               /* pins to the very top */
    left: 0;
    right: 0;             /* stretches full width */
    z-index: 9999;        /* floats above everything else */
    line-height: 1.5;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap, 1rem);
    & nav{
        font-size: var(--textSize, 16px);
    }
    & ul{
            margin: 0;
            padding: 0;
            border-bottom-left-radius:var(--borderBottomLeftRadius, 50%);
            display: flex;
            gap: var(--gap, 1rem);
    }
    & .logo{
            width: 20px;
            height: inherit;
            margin: 2rem;
    }
    & .mobile-nav-toggle {
        display: none;
    }
    & .primary-navigation{
        @supports(backdrop-filter: blur(2rem)) {
            background: hsla(184, 21%, 25%, 0.1);
            backdrop-filter: blur(1rem);
        }
        list-style: none;
        padding: 0;
        margin: 0;
        & a {
            text-decoration: none;
            color: var(--textColor);
        }
        & a>[aria-hidden="true"] {
            font-weight: 700;
            margin-inline-end: .75rem;
        }
    }
}

