    mask-image: linear-gradient(
        to right,
        transparent,
        #000 10% 90%,
        transparent
    );
    & > *{
        list-style: none;
        flex-shrink: 0;
        min-width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: var(--stock-tickerGap);
        animation: scroll var(--stock-tickerScrollSpeed) linear infinite;
        strong{
            color: red;
            font-size: 1.5rem;
            font-weight: 600;
        }
    }
    &:hover > *{
        animation-play-state: paused;
    }
}
@keyframes scroll {
    to {
        transform: translateX(calc(-100% - var(--stock-tickerGap)));
    }
}

