---
import mainImage01 from '../assets/images/background/01planet-2-blu-starbottle2.webp';
import mainImage02 from '../assets/images/background/02GeminipNew.webp';
import mainImage03 from '../assets/images/background/03star-bottle-background-21-dicembre-scaled.webp';
import mainImage04 from '../assets/images/background/04star-bottle-1.webp';


const { companyName ="Company" } = Astro.props;
const { messageURL = "/whysendmessage"} = Astro.props;
const { loveURL = "/lovemessage"} = Astro.props;
const { zodiacURL = "/zodiacmessage"} = Astro.props;
const { eternityURL = "/eternitymesage"} = Astro.props;
const { services = "/services"} = Astro.props;
---
<main class="carousel">
    <!-- list item -->
    <section class="list">
        <article class="item">
            <img src={mainImage01.src}>
            <div class="content">
                <div class="author">{companyName}</div>
                <article>
                    <h2 class="title">SEND A MESSAGE</h2>
                    <h2 class="topic">INTO SPACE</h2>
                    <p class="des">
                        With us, you can send your phrases,
                        thoughts, photos, videos into space and share them with the Universe.
                        Send your message to the deep sky. Leave your mark.
                        Make your story travel among the stars.
                    </p>
                </article>
                <div class="buttons">
                    <a href={messageURL}>SEE MORE </a>
                    <a href={services}>SELECT SERVICES</a>
                </div>
            </div>
        </article>
        <article class="item">
            <img src={mainImage02.src}>
            <div class="content">
                <div class="author">{companyName}</div>
                <article>
                    <h2 class="title">SEND LOVE MESSAGE,</h2>
                    <h2 class="topic">BEYOND TIME</h2>
                    <p class="des">
                        An unsaid 'I love you.' A farewell that should have reached farther. Share your feelings with the universe. Write it. Send it. Let your love travel across galaxies. Send your love message to space.
                    </p>
                </article>
                <div class="buttons">
                    <a href={loveURL}>SEE MORE </a>
                    <a href={services}>SELECT SERVICES</a>
                </div>
            </div>
        </article>
        <article class="item">
            <img src={mainImage03.src}>
            <div class="content">
                <div class="author">{companyName}</div>
                <article>
                    <h2 class="title">SEND A MESSAGE TO</h2>
                    <h2 class="topic">YOUR ZODIAC SIGN</h2>
                    <p class="des">
                        Now you can send a message straight to your zodiac sign—the one you pick: Aries, Taurus, Gemini, Cancer, Leo, Virgo, Libra, Scorpio, Sagittarius, Capricorn, Aquarius, or Pisces. Connect with them. The sky is online just for you now.
                    </p>
                </article>
                <div class="buttons">
                    <a href={zodiacURL}>SEE MORE </a>
                    <a href={services}>SELECT SERVICES</a>
                </div>
            </div>
        </article>
        <article class="item">
            <img src={mainImage04.src}>
            <div class="content">
                <div class="author">{companyName}</div>
                <article>
                    <h2 class="title">SEND YOUR MESSAGE YOU</h2>
                    <h2 class="topic">WANT STRAIGHT TO ETERNITY</h2>
                    <p class="des">
                        Want to send a message to an Eternal Love—for someone no longer here with you? Let your words travel across galaxies. Send your message to the deep heavens right now. Don’t wait. Make your words last forever, leaving your trace in the endless universe.
                    </p>
                </article>
                <div class="buttons">
                    <a href={eternityURL}>SEE MORE </a>
                    <a href={services}>SELECT SERVICES</a>
                </div>
            </div>
        </article>
    </section>
    <!-- list thumnail -->
    <section class="thumbnail">
        <div class="item">
            <img src={mainImage01.src}>
            <div class="content">
                <div class="title">
                    MESSAGE
                </div>
                <!-- <div class="description">
                    Description
                </div> -->
            </div>
        </div>
        <div class="item">
            <img src={mainImage02.src}>
            <div class="content">
                <div class="title">
                    LOVE
                </div>
                <!-- <div class="description">
                    Description
                </div> -->
            </div>
        </div>
        <div class="item">
            <img src={mainImage03.src}>
            <div class="content">
                <div class="title">
                    ZODIAC
                </div>
                <!-- <div class="description">
                    Description
                </div> -->
            </div>
        </div>
        <div class="item">
            <img src={mainImage04.src}>
            <div class="content">
                <div class="title">
                    ETERNITY
                </div>
                <!-- <div class="description">
                    Description
                </div> -->
            </div>
        </div>
    </section>
    <!-- next prev -->
    <section class="arrows">
        <!-- <button id="prev">&#9664;</button> -->
        <button id="next">&#9654;</button>
    </section>
    <!-- time running -->
    
</main>
<div class="fade"></div>

<style>
    
    
:root{
    --titleSize: 2.9rem;
    --companyTextSize: .7rem;
    --titleLineHeight:1.1em;
    --constant01:25px;
}
/* carousel */
.carousel {
    height: 100vh;
    margin-top: -50px;
    width: 100vw;
    overflow: hidden;
    position: relative;
    & a {
        text-decoration: none;
        cursor: pointer;
    }
    & .list {
        & .item {
            width: 100%;
            height: 100%;
            position: absolute;
            inset: 0 0 0 0;

            & img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                /* object-position: center calc(50% - 60px); */
            }

            & .content {
                position: absolute;
                top: 20%;
                width: 1140px;
                max-width: 80%;
                left: 50%;
                transform: translateX(-50%);
                padding-right: 30%;
                box-sizing: border-box;
                color: #fff;
                text-shadow: 0 5px 10px #0004;
                & article{   
                    background: hsla(184, 21%, 25%, 0.1);
                    /* backdrop-filter: blur(.7rem); */
                    border-radius: 50px;
                    width: 70vw;
                    & h2{
                        margin: 0;
                        padding: 0;
                        font-size: var(--titleSize);
                        font-weight: 900;
                        line-height: var(--titleLineHeight);
                        text-shadow: 4px 4px 2px rgba(0, 0, 0, 0.7);
                    }
                    & p{
                        font-size: .92rem;
                        font-weight: 600;
                        word-spacing: 0.4rem;
                        text-shadow: 2px 2px 2px rgba(0, 0, 0, 0.5);
                    }
                }


            }
        
            & .author {
                font-size: var(--companyTextSize);
                font-weight: 600;
                letter-spacing: 9px;
                width: 10px;
            }
            &.title, 
            &.topic {
                /* font-size: var(--titleSize);
                font-weight: 700; */
                line-height: var(--titleLineHeight);
                /* text-shadow: 2px 2px 2px rgba(0, 0, 0, 0.5); */
            }

            & .topic {
                color: var(--letterColor01);
            }

            & .buttons {
                display: grid;
                grid-template-columns: repeat(2, 130px);
                grid-template-rows: 40px;
                gap: 5px;
                margin-top: 20px;

                & a {
                    border: 1px solid #fff;
                    border-radius: 25% ;
                    color: #11dd4e;
                    background-color: #fff;
                    letter-spacing: 3px;
                    font-weight: 900;
                    font-size: .63rem;
                    text-decoration: none;
                    padding: 5px 10px; 
                    text-align: center; 
                    display: flex;
                    justify-content: center; 
                    align-items: center;
                    text-shadow: 0px 0px 1px rgba(0, 0, 0, 0.7);     
                    &:nth-child(2) {
                        background-color: transparent;
                        border: 1px solid #fff;
                        color: #eee;
                    }
                }
            }
        }

        /* animation text in first item */
        & .item:nth-child(1) {
            z-index: 1;

            & .content {
                & .author,& .title,& .topic,& .des,& .buttons {
                    transform: translateY(50px);
                    filter: blur(20px);
                    opacity: 0;
                    animation: showContent .5s 1s linear 1 forwards;
                }
                & .author{
                    /* TODO:See that bottom width does not cause a bug*/
                    width: 60vw;    
                }
                & .title {
                    animation-delay: 1.2s !important;
                }
                & .topic {
                    animation-delay: 1.4s !important;
                }
                & .des {
                    animation-delay: 1.6s !important;
                }
                & .buttons {
                    animation-delay: 1.8s !important;
                }
            }
        }
    }

    /* next click */
    &.next {
        & .list {
            & .item:nth-child(1) img {
                width: 150px;
                height: 220px;
                position: absolute;
                bottom: 50px;
                left: 50%;
                border-radius: 30px;
                animation: showImage .5s linear 1 forwards;
            }
        }

        & .thumbnail {
            animation: effectNext .5s linear 1 forwards;

            & .item:nth-last-child(1) {
                overflow: hidden;
                animation: showThumbnail .5s linear 1 forwards;
            }
        }

        & .arrows button {
            pointer-events: none;
        }
    }

    /* prev click */
    &.prev {
        .list {
            .item img {
                z-index: 100;
            }

            .item:nth-child(2) {
                z-index: 2;

                img {
                    animation: outFrame 0.5s linear 1 forwards;
                    position: absolute;
                    bottom: 0;
                    left: 0;
                }

                .content {
                    .author,
                    .title,
                    .topic,
                    .des,
                    .buttons {
                        animation: contentOut 1.5s linear 1 forwards !important;
                    }
                }
            }
        }

        .thumbnail {
            .item:nth-child(1) {
                overflow: hidden;
                opacity: 0;
                animation: showThumbnail .5s linear 1 forwards;
            }
        }

        .arrows button {
            pointer-events: none;
        }
    }
}

/* thumbnail */
.thumbnail {
    position: absolute;
    bottom: 5px;
    left: 50%;
    width: max-content;
    z-index: 100;
    display: flex;
    gap: 20px;

    .item {
        width: 150px;
        height: 85px;
        flex-shrink: 0;
        position: relative;

        img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 20px;
        }

        .content {
            color: #fff;
            position: absolute;
            bottom: 10px;
            left: 10px;
            right: 10px;

            .title {
                font-weight: 500;
            }

            .description {
                font-weight: 300;
            }
        }
    }
}

/* arrows */
.arrows {
    position: absolute;
    top: 80%;
    right: 52%;
    z-index: 100;
    width: 300px;
    max-width: 30%;
    display: flex;
    gap: 3px;
    align-items: center;

    button {
        cursor: pointer;
        width: 80px;
        height: 40px;
        border-radius: 100% 0 0 100%;
        background-color: rgba(3, 42, 11, 0.339);
        border: none;
        color: #fff;
        font-family: monospace;
        font-weight: bold;
        transition: .5s;
        
        position: relative;
        box-sizing: border-box;

        &:nth-child(2){
            border-radius: 0 100% 100% 0;
            
            /* Setup the fake border background on the Next button */
            background-image: linear-gradient(#f1683a, #f1683a);
            background-repeat: no-repeat;
            background-position: bottom left;
            background-size: 0% 40px; /* Starts at 0% width, 3px height */
        }

        &:hover {
            background-color: #fff;
            color: #000;
            background-image: none; /* Clear gradient on hover */
        }
    }
}
.carousel.next .arrows button#next,
.carousel.prev .arrows button#next {
    animation: runningButtonBorder 3s linear 1 forwards;
}
/* .fade{
    position: relative;
    top: -10px;
    width: 100%;
    height: 130px;
    border: 1px solid #fff;
    z-index: 100;
    background-image: linear-gradient(to bottom, transparent 40%, #000 60%);
} */

/* keyframes */
@keyframes showContent {
    to {
        transform: translateY(0px);
        filter: blur(0px);
        opacity: 1;
    }
}

@keyframes showImage {
    to {
        bottom: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border-radius: 0;
    }
}

@keyframes showThumbnail {
    from {
        width: 0;
        opacity: 0;
    }
}

@keyframes effectNext {
    from {
        transform: translateX(150px);
    }
}

@keyframes outFrame {
    to {
        width: 150px;
        height: 220px;
        bottom: 50px;
        left: 50%;
        border-radius: 20px;
    }
}

@keyframes contentOut {
    to {
        transform: translateY(-150px);
        filter: blur(20px);
        opacity: 0;
    }
}
@keyframes runningButtonBorder {
    from { 
        background-size: 0% 3px; 
    }
    to { 
        background-size: 100% 3px; 
    }
}

@media screen and (max-width: 678px) {
    :root{
        --titleSize: 1.59rem;
        --companyTextSize:.5rem;
        --titleLineHeight:1.1em;
        --constant01:25px;
    }
    .carousel {
        .list {
            .item {
                .content {
                    padding-right: 0;
                    p{
                        font-size: .3rem;
                    }
                    .author{
                        font-size: .5rem;
                    }
                    .title {
                        font-size: 30px;
                    }
                }
            }
        }
    }
}
</style>

<script>
    // step 1: get DOM
    let nextDom = document.getElementById('next');
    // let prevDom = document.getElementById('prev');

    let carouselDom = document.querySelector('.carousel');
    let SliderDom = carouselDom.querySelector('.carousel .list');
    let thumbnailBorderDom = document.querySelector('.carousel .thumbnail');
    let thumbnailItemsDom = thumbnailBorderDom.querySelectorAll('.item');
    //let timeDom = document.querySelector('.carousel .time');

    thumbnailBorderDom.appendChild(thumbnailItemsDom[0]);
    let timeRunning = 3000;
    let timeAutoNext = 7000;

    nextDom.onclick = function(){
        showSlider('next');    
    }

    // prevDom.onclick = function(){
    //     showSlider('prev');    
    // }
    let runTimeOut;
    let runNextAuto = setTimeout(() => {
        nextDom.click(); // FIXED: Changed 'next' to 'nextDom'
    }, timeAutoNext)

    function showSlider(type){
        let SliderItemsDom = SliderDom.querySelectorAll('.carousel .list .item');
        let thumbnailItemsDom = document.querySelectorAll('.carousel .thumbnail .item');
        
        if(type === 'next'){
            SliderDom.appendChild(SliderItemsDom[0]);
            thumbnailBorderDom.appendChild(thumbnailItemsDom[0]);
            carouselDom.classList.add('next');
        }else{
            SliderDom.prepend(SliderItemsDom[SliderItemsDom.length - 1]);
            thumbnailBorderDom.prepend(thumbnailItemsDom[thumbnailItemsDom.length - 1]);
            carouselDom.classList.add('prev');
        }
        clearTimeout(runTimeOut);
        runTimeOut = setTimeout(() => {
            carouselDom.classList.remove('next');
            carouselDom.classList.remove('prev');
        }, timeRunning);

        clearTimeout(runNextAuto);
        runNextAuto = setTimeout(() => {
            nextDom.click(); // FIXED: Changed 'next' to 'nextDom'
        }, timeAutoNext)
    }
</script>
